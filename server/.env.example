# Server Port
PORT=5000

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI (required in Stage 2)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/meulink?retryWrites=true&w=majority

# JWT Authentication (required in Stage 3)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
